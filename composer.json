{
    "name": "mrsleeps/vexim-web-core-settings",
    "description": "Settings module for VExim Web UI",
    "type": "filament-plugin",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Mr Sleeps"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "mrsleeps/vexim-web-core-data": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "relaticle/activity-log": "^1.0",
        "spatie/laravel-activitylog": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "VEximweb\\Core\\Settings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Support/App/",
            "VEximweb\\Core\\Settings\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "VEximweb\\Core\\Settings\\SettingsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
